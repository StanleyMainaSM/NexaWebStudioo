{
  "name": "avelixa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:connector-leads": "node --experimental-strip-types tests/connectorLeadGeneration.test.mjs",
    "test:connector-earnings": "node --experimental-strip-types tests/connectorEarnings.test.mjs",
    "test:connector-lifecycle": "node --experimental-strip-types tests/connectorLeadLifecycle.test.mjs",
    "test:connector-notifications": "node --experimental-strip-types tests/connectorNotifications.test.mjs",
    "test:connector-portal-routing": "node --experimental-strip-types tests/connectorPortalRouting.test.mjs",
    "test:connector-activation": "node --experimental-strip-types tests/connectorActivationLifecycle.test.mjs",
    "test:client-referrals": "node --experimental-strip-types tests/clientReferral.test.mjs",
    "test:client-portal": "node --experimental-strip-types tests/clientPortal.test.mjs",
    "test:invoice-notifications": "node --experimental-strip-types tests/invoiceNotifications.test.mjs",
    "test:payment-finance-handoff": "node --experimental-strip-types tests/paymentFinanceHandoff.test.mjs",
    "test:client-payment-amount": "node --experimental-strip-types tests/clientPaymentAmount.test.mjs",
    "test:website-creation-editor": "node --experimental-strip-types tests/websiteCreationEditor.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "tsx": "^4.23.11"
  }
}
