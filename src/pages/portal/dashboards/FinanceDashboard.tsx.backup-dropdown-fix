                            )}
                          </button>
                        </div>
                      </div>
                    )}

                    {paid && (
                      <div className="inline-flex items-center gap-2 text-sm text-emerald-400">
                        <CheckCircle2 className="w-4 h-4" />
                        Operator payment confirmed as paid.
                      </div>
                    )}

                    {cancelled && (
                      <div className="inline-flex items-center gap-2 text-sm text-red-400">
                        <XCircle className="w-4 h-4" />
                        Operator payment cancelled.
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      <div className="glass rounded-2xl overflow-hidden">
        <div className="p-6 border-b border-white/5">
          <div className="flex items-center gap-3">
            <FileText className="w-5 h-5 text-accent-500" />

            <div>
              <h2 className="text-xl font-medium text-white">
                Financial Records
              </h2>

              <p className="text-sm text-gray-500 mt-1">
                Recorded financial transactions and their verification
                evidence.
              </p>
            </div>
          </div>
        </div>

        {financialRecords.length === 0 ? (
          <div className="p-8 text-center text-gray-500">
            No financial records recorded yet.
          </div>
        ) : (
          <div className="divide-y divide-white/5">
            {financialRecords.slice(0, 10).map((record) => (
              <div
                key={record.id}
                className="p-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
              >
                <div className="min-w-0">
                  <div className="flex flex-wrap items-center gap-3">
                    <span className="text-sm font-medium text-white">
                      {formatStatus(record.record_type)}
                    </span>

                    <span className="text-xs text-gray-500">
                      {record.category}
                    </span>

                    <span
                      className={`inline-flex rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${getStatusClasses(
                        record.status
                      )}`}
                    >
                      {formatStatus(record.status)}
                    </span>
                  </div>

                  <div className="text-xs text-gray-500 mt-2 whitespace-pre-wrap break-words">
                    {record.description || 'No verification message'}
                  </div>

                  <div className="text-xs text-gray-600 mt-1">
                    {formatDate(record.record_date)}
                    {record.reference_number
                      ? ` • ${record.reference_number}`
                      : ''}
                  </div>
                </div>

                <div className="text-sm font-medium text-white shrink-0">
                  {formatCurrency(toNumber(record.amount))}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}


