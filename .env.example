# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Canonical Avelixa application URL used by server-side invitation links.
# Never leave this unset in a production environment.
APP_URL="https://avelixa.co.ke"

# Client-side application URL for browser redirects and self-referential links.
VITE_APP_URL="https://avelixa.co.ke"

# Supabase configuration for Avelixa platform
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional WebRTC TURN relay. Configure all three in production for reliable calls
# across restrictive NAT/firewall networks. Never commit real TURN credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
